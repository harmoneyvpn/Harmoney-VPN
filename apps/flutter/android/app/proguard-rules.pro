# Keep classes loaded by the embedded VPN engines through reflection/JNI.
-keep class de.blinkt.openvpn.** { *; }
-keep class org.infradead.** { *; }
-keep class com.wireguard.android.** { *; }
-keep class org.conscrypt.** { *; }
-keep class io.netty.** { *; }
-keep class com.google.protobuf.** { *; }

# JNI entry points and native method names must stay stable.
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}

# Preserve runtime annotations/signatures used by Android and Flutter plugins.
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod

# Optional Android/provider APIs referenced by VPN engine compatibility code.
